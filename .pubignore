# NOTE: when this file exists, pub ignores .gitignore entirely — anything that
# must stay out of the published archive has to be listed HERE as well, even if
# git already ignores it.

# Secrets — never publish
credentials.json
openai.key
*.key
*.pem
*.p12
*.jks
*.keystore
service-account*.json

# Archives: a bundle can smuggle out the very files excluded above
arch.z
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# Local configuration and contributor guidance
.vscode/
.claude/
CLAUDE.md
prompt.txt
tool/

# Example: ship only the configuration, the snapshot and the README (pub.dev
# shows example/README.md). The generated output and the packaging files of
# example/dart, example/ts and example/python live in the repository; they
# would only bloat the archive (and example/dart is a nested Flutter package).
example/dart/
example/ts/
example/python/

# Bulky test data: the expected emitter output (~460 KB) and the CLDR sample
# table (~70 KB) only matter in a checkout of the repository, where the tests
# that read them run; nobody runs the tests of a downloaded package.
test/golden/
test/fixtures/cldr_plural_samples.json

# Build, test and tooling output
build/
coverage/
reports/
doc/api/
*.vm.json
